            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response time is less than 1000ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(1000);\r\n});\r\n\r\npm.test(\"Content-Type is JSON\", function () {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\n\r\npm.test(\"Response is a non-empty array\", function () {\r\n    const books = pm.response.json();\r\n    pm.expect(books).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\npm.test(\"Each book has id, title and author\", function () {\r\n    const books = pm.response.json();\r\n    books.forEach(function (book) {\r\n        pm.expect(book.id).to.be.a(\"number\");\r\n        pm.expect(book.title).to.be.a(\"string\");\r\n        pm.expect(book.author).to.be.a(\"string\");\r\n    });\r\n});\r\n"
            ]
          }
        }
